{
  "expo": {
    "name": "小步日常",
    "slug": "sprout-checkin-native",
    "version": "1.0.16",
    "icon": "./assets/icon.png",
    "scheme": "sprout",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.smallsteps.checkin",
      "infoPlist": {
        "NSBonjourServices": ["_sprout-checkin._tcp"],
        "NSLocalNetworkUsageDescription": "在同一 WiFi 下与小组成员交换打卡和奖券记录"
      }
    },
    "android": {
      "versionCode": 17,
      "package": "com.smallsteps.checkin",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFCF1"
      },
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ]
    },
    "plugins": [
      "expo-sqlite",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "选择一张图片作为本机头像",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "允许小步使用相机扫描赠券二维码",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ]
    ],
    "autolinking": {
      "nativeModulesDir": "./modules"
    }
  }
}
